{"book": "gate-da", "num": 15, "label": "15", "slug": "15-matrices-summary-very-important", "title": "Summary - Very Important", "tag": "Matrices & Linear Algebra", "summary": "Homogeneous, Non-homogeneous; Trivial/non-trivial solutions", "wordCount": 355, "readingTimeMin": 2, "intro": [], "sections": [{"id": "15.1", "title": "1. Types of Linear Systems", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "Linear Systems", "blocks": [{"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "<b>Homogeneous:</b> $AX=0$"}, {"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "Always consistent"}]}, {"blocks": [{"t": "p", "x": "Trivial solution: $X=0$"}]}, {"blocks": [{"t": "p", "x": "Non-trivial solution if $\\text{rank}(A)<n$"}]}, {"blocks": [{"t": "p", "x": "Nullity = $n - \\text{rank}(A)$ → number of free variables"}]}]}]}, {"blocks": [{"t": "p", "x": "<b>Non-homogeneous:</b> $AX=b$"}, {"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "Consistent if $\\text{rank}(A) = \\text{rank}([A|b])$"}]}, {"blocks": [{"t": "p", "x": "No solution if $\\text{rank}(A) \\neq \\text{rank}([A|b])$"}]}]}]}]}]}, {"t": "p", "x": "<b>Space to write examples:</b>"}]}, {"id": "15.2", "title": "2. Rank and Nullity", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "Rank and Nullity", "blocks": [{"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "Rank: Number of linearly independent rows/columns"}]}, {"blocks": [{"t": "p", "x": "Nullity: $n - \\text{rank}(A)$"}]}, {"blocks": [{"t": "p", "x": "Dimension of null space → solutions to $AX=0$"}]}, {"blocks": [{"t": "p", "x": "Number of free variables = nullity"}]}]}]}]}, {"id": "15.3", "title": "3. Rouché–Capelli Theorem (Consistency)", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "Consistency", "blocks": [{"t": "p", "x": "System $AX=b$ is consistent iff:"}, {"t": "math", "x": "\\text{rank}(A) = \\text{rank}([A|b])"}, {"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "Unique solution: rank = n (full rank)"}]}, {"blocks": [{"t": "p", "x": "Infinite solutions: rank &lt; n and consistent"}]}, {"blocks": [{"t": "p", "x": "No solution: rank([A|b]) &gt; rank(A)"}]}]}]}]}, {"id": "15.4", "title": "4. Homogeneous Systems", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "Homogeneous Systems", "blocks": [{"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "Always consistent"}]}, {"blocks": [{"t": "p", "x": "Trivial solution: $X=0$"}]}, {"blocks": [{"t": "p", "x": "Non-trivial solution exists if $\\text{rank}(A)<n$"}]}, {"blocks": [{"t": "p", "x": "All solutions are linear combinations of basis vectors of null space"}]}]}]}]}, {"id": "15.5", "title": "5. Determinants and Invertibility", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "Determinants", "blocks": [{"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "$\\det(A)\\neq 0 \\Rightarrow$ Full rank, invertible"}]}, {"blocks": [{"t": "p", "x": "$\\det(A)=0 \\Rightarrow$ Singular, rank $<$ n"}]}, {"blocks": [{"t": "p", "x": "Non-homogeneous system unique solution only if $\\det(A)\\neq0$"}]}]}]}]}, {"id": "15.6", "title": "6. LU Decomposition", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "LU Decomposition", "blocks": [{"t": "math", "x": "A = LU, \\quad L=\\text{lower triangular}, \\quad U=\\text{upper triangular}"}, {"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "Solve $AX=b$ via:"}, {"t": "list", "ordered": true, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "$LY=b$ (forward substitution)"}]}, {"blocks": [{"t": "p", "x": "$UX=Y$ (backward substitution)"}]}]}]}, {"blocks": [{"t": "p", "x": "$A$ invertible $\\Rightarrow$ L and U invertible"}]}, {"blocks": [{"t": "p", "x": "Singular $A \\Rightarrow$ at least one zero on U diagonal"}]}]}]}]}, {"id": "15.7", "title": "7. Eigenvalues and Eigenvectors", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "Eigenvalues", "blocks": [{"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "$Av = \\lambda v$"}]}, {"blocks": [{"t": "p", "x": "Trace = sum of eigenvalues"}]}, {"blocks": [{"t": "p", "x": "Determinant = product of eigenvalues"}]}, {"blocks": [{"t": "p", "x": "Rank = number of non-zero eigenvalues"}]}, {"blocks": [{"t": "p", "x": "Symmetric matrices → real eigenvalues, orthogonal eigenvectors"}]}]}]}]}, {"id": "15.8", "title": "8. Underdetermined and Overdetermined Systems", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "Under/Overdetermined", "blocks": [{"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "$m<n$: fewer equations → infinite solutions (if consistent)"}]}, {"blocks": [{"t": "p", "x": "$m>n$: more equations → may be inconsistent"}]}, {"blocks": [{"t": "p", "x": "$m=n$: full rank → unique solution possible"}]}]}]}]}, {"id": "15.9", "title": "9. Free Variables and Infinite Solutions", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "Free Variables", "blocks": [{"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "Free variables = $n - \\text{rank}(A)$"}]}, {"blocks": [{"t": "p", "x": "Infinite solutions = linear combination of null space basis"}]}, {"blocks": [{"t": "p", "x": "Homogeneous: all solutions = linear combinations of null space vectors"}]}]}]}]}, {"id": "15.10", "title": "10. Parameter-Dependent Systems", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "Parameters", "blocks": [{"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "Compute determinant/rank symbolically"}]}, {"blocks": [{"t": "p", "x": "Solve for parameters:"}, {"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "Infinitely many solutions → rank drops"}]}, {"blocks": [{"t": "p", "x": "Unique solution → full rank"}]}, {"blocks": [{"t": "p", "x": "No solution → augmented rank $>$ rank"}]}]}]}]}]}]}, {"id": "15.11", "title": "11. Linear Dependence of Columns", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "Linear Dependence", "blocks": [{"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "Columns $a_1,\\dots,a_n$ linearly dependent if $\\sum c_i a_i = 0, c_i \\neq 0$"}]}, {"blocks": [{"t": "p", "x": "Implication: solution may be infinite or none depending on augmented rank"}]}]}]}]}, {"id": "15.12", "title": "12. Key Tricks and Observations", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "Tricks", "blocks": [{"t": "list", "ordered": false, "style": null, "desc": false, "items": [{"blocks": [{"t": "p", "x": "Sum of singular matrices → may be non-singular"}]}, {"blocks": [{"t": "p", "x": "Sum of non-singular matrices → may be singular"}]}, {"blocks": [{"t": "p", "x": "Zero determinant → each row/column = linear combination of others"}]}, {"blocks": [{"t": "p", "x": "Eigenvalues of symmetric → real"}]}, {"blocks": [{"t": "p", "x": "LU decomposition: forward/backward substitution"}]}]}]}]}, {"id": "15.13", "title": "Summary", "blocks": [{"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "1. Types of Systems", "blocks": [{"t": "p", "x": "Homogeneous, Non-homogeneous; Trivial/non-trivial solutions"}]}, {"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "2. Rank and Nullity", "blocks": [{"t": "p", "x": "Rank = independent rows/columns; Nullity = n - rank"}]}, {"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "3. Consistency (Rouché–Capelli)", "blocks": [{"t": "p", "x": "System consistent if rank(A) = rank([A|b])"}]}, {"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "4. Homogeneous Systems", "blocks": [{"t": "p", "x": "Always consistent; non-trivial if rank &lt; n"}]}, {"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "5. Determinants and Invertibility", "blocks": [{"t": "p", "x": "det(A) ≠ 0 → invertible; det(A) = 0 → singular"}]}, {"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "6. LU Decomposition", "blocks": [{"t": "p", "x": "Solve AX=b via LY=b, UX=Y; L,U invertible if A invertible"}]}, {"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "7. Eigenvalues and Eigenvectors", "blocks": [{"t": "p", "x": "$Av = \\lambda v$; Symmetric → real eigenvalues, orthogonal eigenvectors"}]}, {"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "8. Under/Overdetermined Systems", "blocks": [{"t": "p", "x": "m$<$n → infinite solutions; m&gt;n → may be inconsistent"}]}, {"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "9. Free Variables and Infinite Solutions", "blocks": [{"t": "p", "x": "Free variables = n - rank(A); infinite solutions = linear combinations"}]}, {"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "10. Parameter-Dependent Systems", "blocks": [{"t": "p", "x": "Use determinant/rank symbolically to find parameter values for solution type"}]}, {"t": "box", "kind": "theorem", "name": "Concept", "num": null, "title": "11. Linear Dependence of Columns", "blocks": [{"t": "p", "x": "Columns dependent → solution may be infinite or none depending on augmented rank"}]}]}], "sectionCount": 13}